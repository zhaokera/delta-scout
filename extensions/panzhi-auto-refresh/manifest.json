{
  "manifest_version": 3,
  "name": "盼之自动刷新",
  "version": "0.1.0",
  "description": "使用一个现有盼之标签页完成本机候选台的自动刷新。",
  "permissions": [
    "alarms",
    "tabs",
    "scripting",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "https://www.pzds.com/*",
    "http://127.0.0.1:4310/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://www.pzds.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
